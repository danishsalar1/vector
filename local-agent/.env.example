# VECTOR Local Agent Environment Variables
# Copy this file to .env and fill in any non-default values.
# Never commit .env to git.

# Bind address (default: 127.0.0.1 - loopback only)
# VECTOR_HOST=127.0.0.1

# Port (default: 8742)
# VECTOR_PORT=8742

# ADB executable path (default: adb - uses PATH)
# VECTOR_ADB_PATH=adb

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# VECTOR_LOG_LEVEL=INFO

# Demo mode: true to return synthetic demo data
# WARNING: Never set to true when a real device is connected
# VECTOR_DEMO_MODE=false
