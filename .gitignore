# ============================================================
# VECTOR - .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*.class
*.pyo
*.pyd
.Python
env/
.env
.venv/
venv/
ENV/
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml
*.log

# ----- uv / pip -----
uv.lock
*.lock

# ----- Node / Frontend -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp/
.pnp.js
.yarn/
.next/
out/
.nuxt/
.svelte-kit/
*.tsbuildinfo

# ----- Vite -----
frontend/dist/
frontend/.vite/

# ----- OS -----
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ----- IDEs -----
.idea/
*.swp
*.swo
*~

# ----- Secrets & environment -----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# ----- Benchmark intermediates -----
benchmark/artifacts/*/raw/
benchmark/artifacts/*/tmp/

# ----- Device logs (may contain identifiers) -----
device_logs/
*.device.log
*.adb.log

# ----- Reports with real device data -----
reports/real/

# ----- Coverage / test artifacts -----
.coverage
htmlcov/
.pytest_cache/
junit*.xml

# ----- Local agent data -----
local-agent/.data/
local-agent/scans/

# Local Antigravity/Impeccable runtime
.agent/
